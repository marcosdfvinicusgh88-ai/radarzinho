# Porta em que o servidor vai rodar
PORT=3001

# Token secreto para acessar o painel /admin (troque por algo forte!)
ADMIN_TOKEN=troque-este-token-por-um-bem-forte

# Domínio(s) do site que podem chamar essa API (separe por vírgula se houver mais de um)
# Ex: https://danielradar70000.com.br,https://www.danielradar70000.com.br
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
